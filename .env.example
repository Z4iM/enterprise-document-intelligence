# Development must be explicit. Default cookie settings require HTTPS.
EDI_ENV=development
EDI_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://127.0.0.1:8000
# EDI_DATABASE_URL=sqlite:///data/database.db
# EDI_DATABASE_URL=postgresql+psycopg://user:password@127.0.0.1:5432/edi
# EDI_DATA_ROOT=data
EDI_PROCESSING_MODE=embedded
EDI_OCR_LANGUAGES=eng+ara
# Optional verified local semantic encoder; empty uses explicitly labeled keyword search.
# EDI_RETRIEVAL_MODEL_DIR=D:/EDI-Storage/models/edi-multilingual-faf4aa42

# Optional backend configuration; do not put real secrets in this example.
# Without a configured model, extraction uses fallback and requires correction.
LLM_PROVIDER=disabled
# LLM_PROVIDER=http
# LLM_API_URL=
# LLM_API_KEY=

# Gemini requires separate approval for real API usage.
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=

# These local-only APIs remain disabled unless explicitly enabled.
EDI_ENABLE_DEV_AGENT=false
EDI_ENABLE_DEV_WORKFLOWS=false
ENABLE_DEV_POLICY_REVIEW=false
# EDI_DEV_AGENT_TOKEN=
# Investigation resource scope comes from the signed-in account; no ID lists required.
# EDI_DEV_WORKFLOW_TOKEN=
# DEV_REVIEW_TOKEN=
# DEV_REVIEWER_ID=local-reviewer
