# FastAPI base URL, read only by Next.js server (not exposed to the browser).
BACKEND_API_URL=http://127.0.0.1:8000

# Server-only local investigation gateway, disabled by default.
EDI_ENABLE_DEV_AGENT_FRONTEND=false
# EDI_DEV_AGENT_TOKEN=

# Server-only workflow gateway; production builds always keep it disabled.
EDI_ENABLE_DEV_WORKFLOWS_FRONTEND=false
# EDI_DEV_WORKFLOW_TOKEN=
# Optional isolated verification port; must remain HTTP on 127.0.0.1.
# EDI_DEV_WORKFLOW_ORIGIN=http://127.0.0.1:3000
